# --- Clerk (authentication) ---------------------------------------------
# Create a free Clerk application at https://dashboard.clerk.com, enable
# Google as a sign-in method, then copy the keys from API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- MongoDB ---------------------------------------------------------------
# A connection string from MongoDB Atlas (or any reachable MongoDB instance).
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/careerforge

# --- Gemini ------------------------------------------------------------
# Used to fund each new user's one free career analysis. Get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- App secrets -------------------------------------------------------
# Any long random string. Used to derive the AES-256 key that encrypts
# users' personal Gemini API keys at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Local dev only ------------------------------------------------------
# Port the Vite dev server binds to (defaults to 5173 if unset).
PORT=5173
# Port the local Express API server binds to (defaults to 3001 if unset).
# Also used by Vite's dev proxy to reach the API server.
API_PORT=3001
